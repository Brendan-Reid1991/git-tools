#!/usr/bin/env bash
set -euo pipefail

bin_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
commands_dir="$bin_dir/../lib/commands" # gra-install-path$

filename_regex=".*/([^/]+)\.sh$"

show_all() {
  printf "Available commands\n" >&2
  for entry in "$commands_dir"/*
  do
    if [[ "$entry" =~ $filename_regex ]]; then
      echo " - gra ${BASH_REMATCH[1]}"
    fi
  done
}

case "${1:-}" in
  ""|-h|--help)
    printf 'Usage: gra <command> [arguments...]\n'
    show_all
    exit 0
    ;;
esac

command_name="$1"
shift

if [[ ! "$command_name" =~ ^[a-z][a-z0-9-]*$ ]]; then
  printf 'Invalid command name: %s\n' "$command_name" >&2
  show_all
  exit 2
fi

command_file="$commands_dir/$command_name.sh"

if [[ ! -f "$command_file" ]]; then
  printf 'Unknown command: %s\n' "$command_name" >&2
  show_all
  exit 2
fi

exec bash "$command_file" "$@"